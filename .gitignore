# Portfolio data, wherever it is kept. *.db is deliberately broad: a
# PORTFOLIO_DATA_DIR pointed inside the repo must not commit someone's money.
*.db
*.db-wal
*.db-shm
# Copies of the portfolio carry exactly what the database does, and a
# timestamp suffix slips past the patterns above.
*.db.backup-*
*.db-wal.backup-*
*.db-shm.backup-*
backend/profiles.json
backend/profiles/
backend/app-config.json
backend/stockcaps.json
__pycache__/
*.pyc
frontend/node_modules/
frontend/dist/
build/
dist/
.venv/
*.spec.bak
.pytest_cache/
